#!/usr/bin/env python

"""Fit ProtoSTEEL (DESI tertiary programs 51/52/55) galaxy spectra and photometry.

ProtoSTEEL targets young stellar objects and star-forming regions observed by
DESI. Program details:
  https://desi.lbl.gov/trac/wiki/SurveyOps/TertiaryPrograms#Tertiaryprogram0051

This script wraps FastSpecFit to process healpix coadds or cumulative tile
coadds. Use --coadd-type to select; output files mirror the DESI spectroscopic
reduction directory structure under the project directory.

Required environment variables:
  DESI_ROOT            Root of the DESI data filesystem.

Example usage (on Perlmutter):
  salloc -N 1 -C cpu -A desi -t 04:00:00 --qos interactive

  # Fit healpix coadds (default):
  time ./fastspecfit-protosteel --fastspec --mp 128

  # Fit cumulative tile coadds:
  time ./fastspecfit-protosteel --fastspec --coadd-type cumulative --mp 128

  # Merge per-coadd outputs into a single catalog:
  time ./fastspecfit-protosteel --merge-fastspec --coadd-type cumulative --mp 24

  # Build QA figures:
  time ./fastspecfit-protosteel --fastspec-qa --coadd-type cumulative --mp 128

  # Refit a subset of targets at their VI redshifts:
  time ./fastspecfit-protosteel --fastspec --vi-redshifts --mp 128

"""
import os, subprocess
import numpy as np
import fitsio
from astropy.table import Table

from desiutil.log import get_logger
log = get_logger()


desi_root = os.getenv('DESI_ROOT')
projectdir = os.path.join(desi_root, 'users', 'ioannis', 'desihiz')
selection = 'protosteel'
version = 'v20260616'

_catalog = os.path.join(projectdir, selection, version, f'desi-{selection}.fits')
fphotodir = f'{_catalog}[PHOTINFO]'
fphotofile = os.path.join(projectdir, 'phot', f'{selection}-photinfo.yaml')

_specprods = ['tertiary51', 'tertiary52', 'tertiary55']


def _parse_fitsext(filepath):
    """Parse an optional FITS extension name from a 'path[EXTNAME]' string."""
    ext = None
    dirpath = os.path.dirname(filepath)
    basename = os.path.basename(filepath)
    if '[' in basename and ']' in basename:
        try:
            ext = basename[basename.find('[')+1:basename.find(']')]
            filepath = os.path.join(dirpath, basename[:basename.find('[')])
        except Exception:
            pass
    return filepath, ext


def _specprod_dir(coaddfile):
    """Extract the specprod root (ending in /healpix or /tiles) from a coadd path."""
    for tag in ('/healpix/', '/tiles/'):
        if tag in coaddfile:
            return coaddfile[:coaddfile.index(tag) + len(tag) - 1]
    raise ValueError(f'Cannot determine coadd type from path: {coaddfile}')


def _outdir(prefix, coadd_type=None):
    """Return the top-level output directory for a given run prefix.

    Healpix paths need an explicit 'healpix' subdirectory because the path
    remainder after specprod_dir starts with the survey name, not 'healpix'.
    Cumulative paths already carry 'cumulative/' from the tiles directory
    structure, so no extra subdirectory is added.
    """
    base = os.path.join(projectdir, selection, prefix)
    if coadd_type == 'healpix':
        return os.path.join(base, 'healpix')
    return base


def _outfile(redrockfile, prefix, specprod_dir, coadd_type=None):
    """Derive the FastSpecFit output path from a redrock file path.

    Mirrors the convention in fastspecfit.mpi.plan:
      outfile = redrockfile.replace(specprod_dir, outdir).replace('redrock-', f'{prefix}-')
    """
    outdir = _outdir(prefix, coadd_type=coadd_type)
    fastfile = redrockfile.replace(specprod_dir, outdir).replace('redrock-', f'{prefix}-')
    if not prefix.startswith('fastphot'):
        fastfile += '.gz'
    return fastfile


def _get_cumulative_redrockfiles():
    """Return (redrockfile, tiles_dir) pairs across all tertiary specprods.

    Reads each specprod's exposures CSV to obtain unique tile IDs, then
    globs for the latest-night cumulative redrock file for each tile.
    """
    from fastspecfit.mpi import findfiles
    redux_dir = os.path.join(desi_root, 'spectro', 'redux')
    result = []
    for specprod in _specprods:
        exposures_csv = os.path.join(redux_dir, specprod, f'exposures-{specprod}.csv')
        if not os.path.isfile(exposures_csv):
            log.warning(f'Exposures file not found: {exposures_csv}')
            continue
        exp = Table.read(exposures_csv)
        tiles = np.unique(exp['TILEID'])
        log.info(f'{specprod}: {len(tiles)} unique tiles from {exposures_csv}')
        tiles_dir = os.path.join(redux_dir, specprod, 'tiles')
        redrockfiles = findfiles(tiles_dir, prefix='redrock', coadd_type='cumulative', tile=tiles)
        log.info(f'{specprod}: {len(redrockfiles)} cumulative redrock files found')
        for rr in redrockfiles:
            result.append((rr, tiles_dir))
    return result


def read_catalog(targetids=None, vi_redshifts=False, vi_quality_cut=2.0):
    """Read the ProtoSTEEL photometric and spectroscopic catalogs.

    Parameters
    ----------
    targetids : str or None
        Comma-separated list of TARGETIDs to keep, or None for all.
    vi_redshifts : bool
        If True, restrict to objects with valid visual-inspection redshifts.
    vi_quality_cut : float
        Minimum VI_QUALITY score when ``vi_redshifts`` is True.

    Returns
    -------
    fphoto, fspec : :class:`astropy.table.Table`
        Photometric and spectroscopic catalog tables, row-matched on TARGETID.
    """
    specpath, specext = _parse_fitsext(f'{_catalog}[SPECINFO]')
    photpath, photext = _parse_fitsext(fphotodir)

    fphoto = Table(fitsio.read(photpath, ext=photext))
    log.info(f'Read {len(fphoto):,d} objects from {photpath}')

    fspec = Table(fitsio.read(specpath, ext=specext))
    log.info(f'Read {len(fspec):,d} objects from {specpath}')
    assert np.all(fspec['TARGETID'] == fphoto['TARGETID'])

    if targetids is not None:
        I = np.isin(fspec['TARGETID'], np.array(targetids.split(','), dtype=np.int64))
        log.info(f'Trimming to {I.sum():,d} specified TARGETIDs.')
        fphoto = fphoto[I]
        fspec = fspec[I]

    if vi_redshifts:
        I = np.where(
            np.isfinite(fspec['VI_Z']) &
            (fspec['VI_Z'] > 1e-3) &
            (fspec['VI_QUALITY'] >= vi_quality_cut)
        )[0]
        log.info(f'Trimming to {len(I):,d} objects with VI_Z>0.001 and VI_QUALITY>={vi_quality_cut}.')
        fphoto = fphoto[I]
        fspec = fspec[I]

    return fphoto, fspec


def run_fastspec(targetids=None, fastphot=False, vi_redshifts=False,
                 coadd_type='healpix', mp=1, ntargets=None, nolog=False, overwrite=False):
    """Run FastSpecFit on each ProtoSTEEL coadd file.

    For healpix coadds, iterates over unique coadd files in the catalog's
    COADDFN column. For cumulative tile coadds, discovers redrock files from
    the per-specprod exposures CSVs. Output files mirror the specprod directory
    structure under the project directory.

    Parameters
    ----------
    targetids : str or None
        Comma-separated TARGETIDs to process, or None for all.
    fastphot : bool
        If True, run fastphot (photometry only) instead of fastspec.
    vi_redshifts : bool
        If True, refit at visual-inspection redshifts.
    coadd_type : str
        Either ``'healpix'`` (default) or ``'cumulative'``.
    mp : int
        Number of multiprocessing workers.
    ntargets : int or None
        Limit the number of targets per coadd (useful for testing).
    nolog : bool
        If True, write output to stdout rather than a per-coadd log file.
    overwrite : bool
        If True, overwrite existing output files.
    """
    from desispec.parallel import stdouterr_redirected

    prefix = 'fastphot' if fastphot else 'fastspec'
    if vi_redshifts:
        prefix += '-vi'

    _, fspec = read_catalog(targetids=targetids, vi_redshifts=vi_redshifts)

    if coadd_type == 'healpix':
        iteration = []
        for orig_coaddfile in sorted(set(fspec['COADDFN'])):
            I = fspec['COADDFN'] == orig_coaddfile
            redrockfile = os.path.join(
                os.path.dirname(orig_coaddfile),
                os.path.basename(orig_coaddfile).replace('coadd-', 'redrock-'),
            )
            specprod_dir = _specprod_dir(orig_coaddfile)
            iteration.append((redrockfile, specprod_dir, I))
    else:
        iteration = [(rr, td, None) for rr, td in _get_cumulative_redrockfiles()]

    for redrockfile, specprod_dir, I in iteration:
        if not os.path.isfile(redrockfile):
            log.warning(f'Redrock file not found: {redrockfile}')
            continue

        fastfile = _outfile(redrockfile, prefix, specprod_dir, coadd_type=coadd_type)
        os.makedirs(os.path.dirname(fastfile), exist_ok=True)

        if os.path.isfile(fastfile) and not overwrite:
            log.info(f'Output file {fastfile} exists; use --overwrite to overwrite.')
            continue

        cmdargs = (
            f'{redrockfile} -o {fastfile} --mp {mp}'
            f' --fphotodir={fphotodir} --fphotofile={fphotofile}'
            f' --ignore-quasarnet'
        )
        if ntargets:
            cmdargs += f' --ntargets {ntargets}'
        if vi_redshifts:
            vi_rows = fspec[I] if I is not None else fspec
            targetids_str = ','.join(vi_rows['TARGETID'].astype(str))
            input_redshifts = ','.join(vi_rows['VI_Z'].astype(str))
            cmdargs += f' --targetids {targetids_str} --input-redshifts {input_redshifts}'

        if fastphot:
            from fastspecfit.fastspecfit import fastphot as fast
            log.info(f'fastphot {cmdargs}')
        else:
            from fastspecfit.fastspecfit import fastspec as fast
            log.info(f'fastspec {cmdargs}')

        if nolog:
            fast(args=cmdargs.split())
        else:
            logfile = fastfile.replace('.fits.gz', '.log').replace('.fits', '.log')
            with stdouterr_redirected(to=logfile, overwrite=True):
                fast(args=cmdargs.split())


def merge_fastspec(mp=1, vi_redshifts=False, fastphot=False, coadd_type='healpix',
                   overwrite=False):
    """Merge all per-coadd FastSpecFit outputs into a single catalog.

    For healpix, derives the expected output file list from the catalog's
    COADDFN column and warns about any missing files. For cumulative tiles,
    enumerates files via the same redrock-file list used by run_fastspec.

    Parameters
    ----------
    mp : int
        Number of multiprocessing workers passed to the merge step.
    vi_redshifts : bool
        If True, merge the VI-redshift refit outputs.
    fastphot : bool
        If True, merge fastphot outputs instead of fastspec.
    coadd_type : str
        Either ``'healpix'`` (default) or ``'cumulative'``.
    overwrite : bool
        If True, overwrite an existing merged catalog.

    """
    from fastspecfit.mpi import _domerge

    prefix = 'fastphot' if fastphot else 'fastspec'
    if vi_redshifts:
        prefix += '-vi'

    mergefile = os.path.join(projectdir, selection, f'{prefix}-{selection}-{coadd_type}.fits')

    if os.path.isfile(mergefile) and not overwrite:
        log.info(f'Output file {mergefile} exists; use --overwrite to overwrite.')
        return

    fastfiles = []
    if coadd_type == 'healpix':
        _, fspec = read_catalog(vi_redshifts=vi_redshifts)
        for orig_coaddfile in sorted(set(fspec['COADDFN'])):
            redrockfile = os.path.join(
                os.path.dirname(orig_coaddfile),
                os.path.basename(orig_coaddfile).replace('coadd-', 'redrock-'),
            )
            specprod_dir = _specprod_dir(orig_coaddfile)
            fastfile = _outfile(redrockfile, prefix, specprod_dir, coadd_type=coadd_type)
            if os.path.isfile(fastfile):
                fastfiles.append(fastfile)
            else:
                log.warning(f'FastSpec file not found, skipping: {fastfile}')
    else:
        for redrockfile, tiles_dir in _get_cumulative_redrockfiles():
            fastfile = _outfile(redrockfile, prefix, tiles_dir, coadd_type=coadd_type)
            if os.path.isfile(fastfile):
                fastfiles.append(fastfile)
            else:
                log.warning(f'FastSpec file not found, skipping: {fastfile}')

    if not fastfiles:
        log.warning(f'No {prefix} files found; run --fastspec first.')
        return

    _domerge(fastfiles, fastphot=fastphot, mergefile=mergefile, mp=mp)


def fastspec_qa(fastphot=False, vi_redshifts=False, coadd_type='healpix', mp=1,
                ntargets=None, overwrite=False):
    """Build FastSpecFit QA figures for all ProtoSTEEL coadd outputs.

    Iterates over the same (redrockfile, fastfile) pairs as run_fastspec and
    runs fastspecfit-qa on each output file that exists.

    Parameters
    ----------
    fastphot : bool
        If True, generate QA for fastphot outputs instead of fastspec.
    vi_redshifts : bool
        If True, generate QA for the VI-redshift refit outputs.
    coadd_type : str
        Either ``'healpix'`` (default) or ``'cumulative'``.
    mp : int
        Number of multiprocessing workers.
    ntargets : int or None
        Limit the number of targets per coadd (useful for testing).
    overwrite : bool
        If True, overwrite existing QA figures.

    """
    prefix = 'fastphot' if fastphot else 'fastspec'
    if vi_redshifts:
        prefix += '-vi'

    qadir = os.path.join(projectdir, selection, f'qa-{prefix}')

    if coadd_type == 'healpix':
        _, fspec = read_catalog(vi_redshifts=vi_redshifts)
        pairs = []
        for orig_coaddfile in sorted(set(fspec['COADDFN'])):
            redrockfile = os.path.join(
                os.path.dirname(orig_coaddfile),
                os.path.basename(orig_coaddfile).replace('coadd-', 'redrock-'),
            )
            specprod_dir = _specprod_dir(orig_coaddfile)
            fastfile = _outfile(redrockfile, prefix, specprod_dir, coadd_type=coadd_type)
            outdir = os.path.dirname(fastfile).replace(_outdir(prefix), qadir)
            pairs.append((redrockfile, fastfile, outdir))
    else:
        pairs = []
        for rr, td in _get_cumulative_redrockfiles():
            fastfile = _outfile(rr, prefix, td, coadd_type=coadd_type)
            outdir = os.path.dirname(fastfile).replace(_outdir(prefix), qadir)
            pairs.append((rr, fastfile, outdir))

    for redrockfile, fastfile, outdir in pairs:
        if not os.path.isfile(redrockfile):
            log.warning(f'Redrock file not found: {redrockfile}')
            continue
        if not os.path.isfile(fastfile):
            log.warning(f'FastSpec file not found, skipping QA: {fastfile}')
            continue

        cmd = (
            f'fastspecfit-qa {fastfile} -o {outdir}'
            f' --redrockfiles {redrockfile}'
            f' --mp {mp}'
            f' --fphotodir {fphotodir}'
            f' --fphotofile {fphotofile}'
        )
        if ntargets:
            cmd += f' --ntargets {ntargets}'
        if overwrite:
            cmd += ' --overwrite'
        log.info(cmd)
        subprocess.run(cmd.split(), check=True)


def build_qa_html(fastphot=False, vi_redshifts=False, coadd_type='healpix'):
    """Build an HTML navigation page for the QA PNG figures.

    Walks the QA directory, builds a JSON manifest of all PNG files, and
    writes a single self-contained ``index.html`` with client-side navigation
    and search (no server required).

    Parameters
    ----------
    fastphot : bool
        If True, build the page for fastphot QA outputs.
    vi_redshifts : bool
        If True, build the page for VI-redshift refit QA outputs.
    coadd_type : str
        Either ``'healpix'`` (default) or ``'cumulative'``.
    """
    import json
    from glob import glob as _glob

    prefix = 'fastphot' if fastphot else 'fastspec'
    if vi_redshifts:
        prefix += '-vi'

    qadir = os.path.join(projectdir, selection, f'qa-{prefix}')
    root = os.path.join(qadir, coadd_type)

    if not os.path.isdir(root):
        log.warning(f'QA directory not found: {root}')
        return

    records = []
    if coadd_type == 'healpix':
        for sv in sorted(os.scandir(root), key=lambda e: e.name):
            if not sv.is_dir():
                continue
            for prog in sorted(os.scandir(sv.path), key=lambda e: e.name):
                if not prog.is_dir():
                    continue
                for grp in sorted(os.scandir(prog.path), key=lambda e: e.name):
                    if not grp.is_dir():
                        continue
                    for hpx in sorted(os.scandir(grp.path), key=lambda e: e.name):
                        if not hpx.is_dir():
                            continue
                        for png in sorted(_glob(os.path.join(hpx.path, '*.png'))):
                            targetid = os.path.basename(png).replace('.png', '').split('-')[-1]
                            records.append({
                                'survey': sv.name,
                                'program': prog.name,
                                'group': grp.name,
                                'healpix': hpx.name,
                                'targetid': targetid,
                                'path': os.path.relpath(png, start=root),
                            })

    log.info(f'Found {len(records)} QA PNGs under {root}')
    if not records:
        log.warning('No QA files found; run --qa first.')
        return

    title = f'ProtoSTEEL QA · {prefix} · {version}'
    manifest_json = json.dumps(records, separators=(',', ':'))

    # Use placeholder substitution to avoid f-string brace escaping in CSS/JS.
    template = """\
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>__TITLE__</title>
<style>
body{font-family:sans-serif;max-width:1000px;margin:0 auto;padding:1em;color:#333}
h1{font-size:1.15em;border-bottom:1px solid #ccc;padding-bottom:.3em}
#search{width:100%;box-sizing:border-box;padding:.5em;font-size:1em;margin-bottom:.75em}
#nav{margin-bottom:.6em;font-size:.9em;color:#555}
.row{padding:.4em .5em;border-bottom:1px solid #eee;cursor:pointer}
.row:hover{background:#f5f5f5}
.grid{display:flex;flex-wrap:wrap;gap:.5em;margin-top:.5em}
.thumb{width:180px;text-align:center}
.thumb img{width:180px;border:1px solid #ddd;display:block}
.tid{font-size:.65em;color:#666;word-break:break-all;margin-top:.2em}
a{color:#0066cc;text-decoration:none}
a:hover{text-decoration:underline}
h3{margin:.8em 0 .3em;font-size:.9em;color:#555;text-transform:uppercase;letter-spacing:.05em}
</style>
</head>
<body>
<h1>__TITLE__</h1>
<input type="text" id="search" placeholder="search healpix or targetid…" oninput="doSearch()">
<div id="nav"></div>
<div id="content"></div>
<script>
const DATA=__DATA__;
const byGroup={};
DATA.forEach(r=>{
  if(!byGroup[r.group])byGroup[r.group]={};
  if(!byGroup[r.group][r.healpix])byGroup[r.group][r.healpix]=[];
  byGroup[r.group][r.healpix].push(r);
});
function showRoot(){
  document.getElementById('search').value='';
  document.getElementById('nav').innerHTML='';
  const groups=Object.keys(byGroup).sort((a,b)=>+a-+b);
  let h='';
  groups.forEach(g=>{
    const pix=Object.keys(byGroup[g]);
    const n=pix.reduce((s,p)=>s+byGroup[g][p].length,0);
    h+=`<div class="row" onclick="showGroup('${g}')">${g} · ${pix.length} pixel${pix.length>1?'s':''} · ${n} spectra</div>`;
  });
  document.getElementById('content').innerHTML=h||'<p>No QA files found.</p>';
}
function showGroup(g){
  document.getElementById('search').value='';
  const r0=Object.values(byGroup[g])[0][0];
  document.getElementById('nav').innerHTML=
    `<a href="#" onclick="showRoot()">‹ groups</a>   ${r0.survey} / ${r0.program} / ${g}`;
  const pix=Object.keys(byGroup[g]).sort((a,b)=>+a-+b);
  let h='';
  pix.forEach(p=>{
    const n=byGroup[g][p].length;
    h+=`<div class="row" onclick="showPixel('${g}','${p}')">${p} · ${n} spectr${n>1?'a':'um'}</div>`;
  });
  document.getElementById('content').innerHTML=h;
}
function showPixel(g,p){
  document.getElementById('search').value='';
  const recs=byGroup[g][p],r0=recs[0];
  document.getElementById('nav').innerHTML=
    `<a href="#" onclick="showRoot()">‹ groups</a>  `+
    `<a href="#" onclick="showGroup('${g}')">‹ ${g}</a>  `+
    `${r0.survey} / ${r0.program} / ${g} / ${p} · ${recs.length} spectra`;
  let h='<div class="grid">';
  recs.forEach(r=>{
    h+=`<div class="thumb"><a href="${r.path}" target="_blank"><img src="${r.path}" loading="lazy"><div class="tid">${r.targetid}</div></a></div>`;
  });
  document.getElementById('content').innerHTML=h+'</div>';
}
function doSearch(){
  const q=document.getElementById('search').value.trim();
  if(!q){showRoot();return;}
  document.getElementById('nav').innerHTML='';
  let h='';
  const mg=Object.keys(byGroup).filter(g=>g.includes(q)).sort((a,b)=>+a-+b);
  if(mg.length){
    h+='<h3>Healpix groups</h3>';
    mg.forEach(g=>{
      const pix=Object.keys(byGroup[g]);
      const n=pix.reduce((s,p)=>s+byGroup[g][p].length,0);
      h+=`<div class="row" onclick="showGroup('${g}')">${g} · ${pix.length} pixels · ${n} spectra</div>`;
    });
  }
  const mp=[];
  Object.keys(byGroup).forEach(g=>Object.keys(byGroup[g]).forEach(p=>{if(p.includes(q))mp.push([g,p]);}));
  if(mp.length){
    h+='<h3>Healpix pixels</h3>';
    mp.sort((a,b)=>+a[1]-+b[1]).forEach(([g,p])=>{
      const n=byGroup[g][p].length;
      h+=`<div class="row" onclick="showPixel('${g}','${p}')">${p} (group ${g}) · ${n} spectra</div>`;
    });
  }
  const mt=DATA.filter(r=>r.targetid.includes(q));
  if(mt.length){
    h+=`<h3>Targets (${mt.length}${mt.length>50?' — showing first 50':''})</h3>`;
    mt.slice(0,50).forEach(r=>{
      h+=`<div class="row"><a href="${r.path}" target="_blank">${r.targetid}</a>   healpix ${r.healpix}</div>`;
    });
  }
  document.getElementById('content').innerHTML=h||`<p>No results for “${q}”.</p>`;
}
showRoot();
</script>
</body>
</html>"""

    html = template.replace('__TITLE__', title).replace('__DATA__', manifest_json)
    htmlfile = os.path.join(root, 'index.html')
    with open(htmlfile, 'w') as f:
        f.write(html)
    log.info(f'Wrote {htmlfile}')


def main():
    """Main entry point."""
    import argparse

    parser = argparse.ArgumentParser(
        description='Run FastSpecFit on ProtoSTEEL (DESI tertiary program 51) observations.',
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument('--mp', type=int, default=1,
                        help='Number of multiprocessing processes.')
    parser.add_argument('-n', '--ntargets', type=int,
                        help='Number of targets per coadd file (for testing).')
    parser.add_argument('--targetids', type=str, default=None,
                        help='Comma-separated list of TARGETIDs to process.')

    parser.add_argument('--fastspec', action='store_true',
                        help='Run fastspec (continuum + emission-line fitting).')
    parser.add_argument('--fastphot', action='store_true',
                        help='Run fastphot (broadband photometry fitting only).')
    parser.add_argument('--merge', action='store_true',
                        help='Merge per-coadd outputs into a single catalog.')
    parser.add_argument('--qa', action='store_true',
                        help='Build FastSpecFit QA figures.')
    parser.add_argument('--html', action='store_true',
                        help='Build HTML navigation page for QA figures.')

    parser.add_argument('--coadd-type', choices=['healpix', 'cumulative'], default='healpix',
                        help='Coadd type to process.')
    parser.add_argument('--vi-redshifts', action='store_true',
                        help='Refit using visual-inspection redshifts.')
    parser.add_argument('--nolog', action='store_true',
                        help='Write output to stdout instead of per-coadd log files.')
    parser.add_argument('--overwrite', action='store_true',
                        help='Overwrite existing output files.')
    args = parser.parse_args()

    if args.fastspec or args.fastphot:
        run_fastspec(targetids=args.targetids, fastphot=args.fastphot,
                     vi_redshifts=args.vi_redshifts, coadd_type=args.coadd_type,
                     overwrite=args.overwrite, nolog=args.nolog,
                     ntargets=args.ntargets, mp=args.mp)

    if args.merge:
        merge_fastspec(fastphot=args.fastphot, mp=args.mp,
                        vi_redshifts=args.vi_redshifts, coadd_type=args.coadd_type,
                        overwrite=args.overwrite)

    if args.qa:
        fastspec_qa(fastphot=args.fastphot, vi_redshifts=args.vi_redshifts,
                    coadd_type=args.coadd_type, mp=args.mp,
                    ntargets=args.ntargets, overwrite=args.overwrite)

    if args.html:
        build_qa_html(fastphot=args.fastphot, vi_redshifts=args.vi_redshifts,
                      coadd_type=args.coadd_type)


if __name__ == '__main__':
    main()
